<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MdpRemote" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_dark</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- D-pad movement buttons (checklist C.3): plain framework ImageButton, so
         the square background below is drawn exactly as authored with no
         Material theming fighting it. Zero margin so every tile butts up
         against its neighbours - the pad reads as one solid block, not
         separate floating buttons. Width/height are overridden per instance in
         the layout (the turn/reverse columns split unevenly, TV-remote style),
         so only the visual properties matter here. -->
    <style name="DpadButton">
        <item name="android:layout_margin">0dp</item>
        <item name="android:background">@drawable/bg_dpad_button</item>
        <item name="android:padding">18dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@android:color/white</item>
    </style>

    <style name="DpadStopButton" parent="DpadButton">
        <item name="android:background">@drawable/bg_dpad_stop</item>
        <item name="android:padding">22dp</item>
    </style>

    <!-- Compass-arranged target-face buttons (checklist C.7). Small MaterialButtons
         need the min size and insets zeroed out, or the M3 default style forces
         them back up to its ~88dp touch target. -->
    <style name="CompassButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
