<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape needs its own layout: the portrait version's stacked content is
     taller than a typical landscape tablet screen, which clipped the logo top
     and hint text bottom (the outer LinearLayout centers, so overflow is cut
     symmetrically off both ends). Splitting into two side-by-side columns
     roughly halves the vertical footprint instead. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_background"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@null"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/app_name"
            android:textColor="@color/primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/connection_tagline"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="220dp"
        android:background="@color/status_border" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp">

        <TextView
            android:id="@+id/connection_state"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status"
            android:gravity="center"
            android:padding="14dp"
            android:text="@string/state_disconnected"
            android:textColor="@color/state_disconnected"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connection_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="@string/no_device"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="260dp"
            android:layout_height="52dp"
            android:text="@string/connect"
            android:textSize="16sp" />

        <Button
            android:id="@+id/listen_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/listen" />

        <TextView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/connection_hint"
            android:textColor="@color/status_border"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
