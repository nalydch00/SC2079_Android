<?xml version="1.0" encoding="utf-8"?>
<!-- A single straight arrow pointing up, reused for Forward (rotation 0) and
     Reverse (rotation 180) via the view's `rotation` attribute, so there is
     only one glyph to keep consistent. -->
<!-- The four diagonal corners (turn/reverse left/right) use ic_dir_turn.xml
     instead, mirrored per corner - see the D-pad comment in view_controls.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Shaft -->
    <path
        android:pathData="M12,20 L12,7"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <!-- Arrowhead -->
    <path
        android:pathData="M12,3 L18,11 L6,11 Z"
        android:fillColor="#FFFFFF" />
</vector>
