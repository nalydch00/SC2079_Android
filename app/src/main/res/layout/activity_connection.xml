<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately the only thing on this screen: get a Bluetooth link up.
     Robot control lives on ControlActivity, opened automatically once
     connected (checklist C.2). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/panel_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@null"
        android:src="@mipmap/ic_launcher_foreground" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="@color/primary"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="32dp"
        android:text="@string/connection_tagline"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/connection_state"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_status"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/state_disconnected"
        android:textColor="@color/state_disconnected"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/connection_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="@string/no_device"
        android:textSize="14sp" />

    <Button
        android:id="@+id/connect_button"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="@string/connect"
        android:textSize="16sp" />

    <Button
        android:id="@+id/listen_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/listen" />

    <Button
        android:id="@+id/disconnect_button"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/disconnect" />

    <TextView
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/connection_hint"
        android:textColor="@color/status_border"
        android:textSize="12sp" />
</LinearLayout>
